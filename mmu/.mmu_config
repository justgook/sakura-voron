CONFIG_MMU_TYPE_VVD_1_0=y
CONFIG_OPTION_VVD_BUFFER=y
CONFIG_CHOICE_MMU_CONNECTION_TYPE_SERIAL=y
CONFIG_CHOICE_MMU_SERIAL_DEVICE_OTHER=y
CONFIG_MMU_SERIAL_DEVICE_OTHER="/dev/serial/by-id/usb-Klipper_stm32g0b1xx_vivid_1E0058001350564137393520-if00"
CONFIG_CHOICE_BUFFER_CONNECTION_TYPE_SERIAL=y
CONFIG_CHOICE_BUFFER_SERIAL_DEVICE_OTHER=y
CONFIG_BUFFER_SERIAL_DEVICE_OTHER="/dev/serial/by-id/usb-Klipper_stm32f042x6_buffer_20001E001543323550393720-if00"
CONFIG_CHOICE_TOOLHEAD_TYPE_OTHER=y
CONFIG_PARAM_TOOLHEAD_EXTRUDER_TO_NOZZLE=71.3
CONFIG_PARAM_SYNC_TO_EXTRUDER=1
CONFIG_PARAM_SYNC_FORM_TIP=1
CONFIG_PARAM_SYNC_PURGE=1
CONFIG_KLIPPER_HOME="~/klipper"
CONFIG_MOONRAKER_HOME="~/moonraker"
CONFIG_KLIPPER_CONFIG_HOME="~/printer_data/config"
CONFIG_PRINTER_CONFIG_FILE="printer.cfg"
CONFIG_MOONRAKER_CONFIG_FILE="moonraker.conf"
CONFIG_SERVICE_KLIPPER="klipper.service"
CONFIG_SERVICE_MOONRAKER="moonraker.service"
CONFIG_INIT_SYSTEMD=y
